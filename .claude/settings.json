{
  "permissions": {
    "allow": [
      "Edit",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status)",
      "Bash(npm run dev)",
      "Bash(npm run lint)",
      "Bash(npm run seed)",
      "Bash(npm run test:watch)",  
      "Bash(npm start)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Read"
    ],
    "ask": [
      "Bash(docker:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm run migrate)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf:*)",
      "Bash(wget:*)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Read(./.env*)",
      "Read(./secrets/**)",
      "WebFetch"
    ],
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable"
  },  
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false
  }
}